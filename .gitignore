# =============================================================================
# HomeLab — .gitignore
# =============================================================================
# Everything below is generated by setup.sh at runtime.
# Only setup.sh, Makefile, README.md, and .gitignore belong in the repo.
# =============================================================================

# -------------------------
# NEVER commit this — contains all credentials and ports
# -------------------------
.env

# -------------------------
# Generated by setup.sh — recreated on every fresh install
# -------------------------
docker-compose.yaml
Dockerfile.dagster
Dockerfile.dbt

# -------------------------
# Generated folders
# -------------------------
dagster_home/
dagster_pipelines/
dbt_project/
dbt_profiles/
init-db/
notebooks/
seaweedfs_data/

# -------------------------
# OS & editor noise
# -------------------------
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# -------------------------
# Python noise
# -------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
